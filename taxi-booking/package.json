{
  "name": "taxi-booking-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/api", "apps/customer", "apps/driver", "apps/admin"],
  "scripts": {
    "dev:api": "npm run dev --workspace @taxi/api",
    "dev:customer": "npm run dev --workspace @taxi/customer",
    "dev:driver": "npm run dev --workspace @taxi/driver",
    "dev:admin": "npm run dev --workspace @taxi/admin",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @taxi/api",
    "db:migrate": "npm run db:migrate --workspace @taxi/api"
  },
  "engines": { "node": ">=20" }
}
